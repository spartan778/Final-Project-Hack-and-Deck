;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hack and Deck"
run/main_scene="uid://bcm0cjq03sytx"
config/features=PackedStringArray("4.4", "C#", "GL Compatibility")
run/max_fps=60
config/icon="uid://cuxeie36cc21j"
config/windows_native_icon="res://Assets/ActionGame/BulletSprite/Kinetic_Bullet_V2.ico"

[autoload]

CoroutineManager="*res://addons/HCoroutines/coroutine_manager.tscn"
NetworkManagerSingleton="*res://Globals/NetworkManager_Singleton.tscn"
RpcManager="*res://Globals/RpcManager.tscn"
SceneManager="*res://Globals/SceneManager.tscn"
CardGameHelperSingleton="*res://Globals/CardGameHelperSingleton.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"

[dotnet]

project/assembly_name="Hack and Deck"

[editor_plugins]

enabled=PackedStringArray("res://addons/HCoroutines/plugin.cfg")

[global_group]

Enemies=""

